# Values are loaded from this file via src.settings._env (python-dotenv).
# DJANGO_SETTINGS_MODULE=src.settings.local
# Alternatives: src.settings.development | src.settings.staging | src.settings.production
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
{% if cookiecutter.use_postgresql == "y" %}
# Compose builds Postgres {{ cookiecutter.postgres_version }} from docker/postgres/Dockerfile (extensions: see docker/postgres/README.md).
DATABASE_URL=postgres://{{ cookiecutter.project_slug }}:{{ cookiecutter.project_slug }}@db:5432/{{ cookiecutter.project_slug }}
{% endif %}
{% if cookiecutter.use_redis_cache == "y" %}
# Django cache (django.core.cache.backends.redis.RedisCache). Compose: use DB index 2 when Celery also uses Redis on the same instance.
REDIS_CACHE_URL=redis://redis:6379/{% if cookiecutter.use_celery == "y" and cookiecutter.celery_broker == "redis" %}2{% else %}0{% endif %}
{% endif %}
{% if cookiecutter.use_celery == "y" %}
{% if cookiecutter.celery_broker == "redis" %}
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
{% else %}
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
{% endif %}
{% endif %}
{% if cookiecutter.api_project == "y" %}
# Comma-separated origins for django-cors-headers (add your SPA URL in staging/prod).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
{% endif %}
